<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studentdb.controller.DashboardController"
      spacing="20" styleClass="content-area">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Dashboard" styleClass="header-label"/>
    
    <HBox spacing="20">
        <VBox styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Total Students" styleClass="card-title"/>
            <Label fx:id="totalStudentsLabel" text="0" styleClass="card-value"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Departments" styleClass="card-title"/>
            <Label fx:id="totalDepartmentsLabel" text="0" styleClass="card-value"/>
        </VBox>
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="Department Distribution" styleClass="card-title"/>
        <VBox fx:id="departmentDistContainer" spacing="10">
            <padding>
                <Insets top="10" right="0" bottom="0" left="0"/>
            </padding>
        </VBox>
    </VBox>
</VBox>
