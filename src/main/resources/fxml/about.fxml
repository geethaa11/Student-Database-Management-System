<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      spacing="20" styleClass="content-area" alignment="CENTER">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="About StudentDB" styleClass="header-label"/>
    
    <VBox styleClass="card" alignment="CENTER" spacing="10" maxWidth="500">
        <Label text="Student Database Management System" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label text="Version 1.0" />
        <Label text="Built with JavaFX, SQLite, and JDBC." />
        <Label text="This application manages student records efficiently." wrapText="true" textAlignment="CENTER"/>
    </VBox>
</VBox>
