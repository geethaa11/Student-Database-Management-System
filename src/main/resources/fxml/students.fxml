<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studentdb.controller.StudentController"
      spacing="20" styleClass="content-area">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Table Section -->
    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Students List" styleClass="header-label"/>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" promptText="Search by name, roll, dept..." prefWidth="200"/>
        </HBox>
        <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colRoll" text="Roll No" prefWidth="100"/>
                <TableColumn fx:id="colName" text="Full Name" prefWidth="150"/>
                <TableColumn fx:id="colDept" text="Department" prefWidth="120"/>
                <TableColumn fx:id="colCgpa" text="CGPA" prefWidth="70"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Form Section -->
    <VBox spacing="10" styleClass="card" prefWidth="350">
        <Label text="Student Details" styleClass="card-title"/>
        <GridPane hgap="10" vgap="10">
            <Label text="Roll Number:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="rollField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Date of Birth:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <DatePicker fx:id="dobPicker" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>

            <Label text="Gender:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <ComboBox fx:id="genderCombo" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="Infinity"/>

            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <Label text="Department:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <ComboBox fx:id="deptCombo" GridPane.columnIndex="1" GridPane.rowIndex="6" maxWidth="Infinity"/>

            <Label text="Year:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
            <TextField fx:id="yearField" GridPane.columnIndex="1" GridPane.rowIndex="7" promptText="1 to 5"/>

            <Label text="CGPA:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
            <TextField fx:id="cgpaField" GridPane.columnIndex="1" GridPane.rowIndex="8" promptText="0.0 to 10.0"/>

            <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
            <TextArea fx:id="addressArea" GridPane.columnIndex="1" GridPane.rowIndex="9" prefRowCount="3"/>
        </GridPane>

        <Region VBox.vgrow="ALWAYS" />
        <Label fx:id="statusLabel" wrapText="true" />
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Clear" onAction="#clearForm" styleClass="btn-secondary"/>
            <Button text="Delete" onAction="#handleDelete" styleClass="btn-danger"/>
            <Button text="Save" onAction="#handleSave" styleClass="btn-primary"/>
        </HBox>
    </VBox>
</HBox>
